# VS Code(EditorConfig 확장)와 IntelliJ(기본 지원)가 함께 읽는 공통 편집 설정
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,py}]
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# 줄 끝 공백 두 칸은 Markdown의 줄바꿈이다
trim_trailing_whitespace = false
