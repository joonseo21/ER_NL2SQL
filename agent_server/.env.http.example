# Supplement the repository .env or use OS environment variables. No real secrets here.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Spring and Python must receive the same token; never send it to a browser.
AGENT_INTERNAL_TOKEN=
# Container-only agent_ro URL. Encode special password characters in the URL.
AGENT_CONTAINER_DATABASE_URL=postgresql://agent_ro:change-me-agent-ro@postgres:5432/er_analytics
# Optional local log override. Containers use their persistent /app/agent_server/logs volume.
AGENT_LOG_PATH=
