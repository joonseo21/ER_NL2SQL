# PostgreSQL / Docker Compose
POSTGRES_DB=er_analytics
POSTGRES_PASSWORD=change-me-postgres
COLLECTOR_PASSWORD=change-me-collector
AGENT_RO_PASSWORD=change-me-agent-ro

# Spring collector
COLLECTOR_DATABASE_URL=jdbc:postgresql://localhost:5433/er_analytics
# Explicit Gradle migration commands use these separately from collector credentials.
# The standalone runner reads OS environment variables, not this file automatically.
MIGRATION_DATABASE_URL=jdbc:postgresql://localhost:5433/er_analytics
MIGRATION_DATABASE_USER=postgres
MIGRATION_DATABASE_PASSWORD=change-me-postgres
ER_API_KEY=
ER_SEASON_ID=41
ER_REQUESTS_PER_SECOND=0.5
ER_COLLECTION_ENABLED=false
ER_COLLECTION_CONTINUOUS=false
ER_REVISIT_INTERVAL=4h
ER_MAX_PAGES_PER_USER=30
ER_IDLE_SLEEP=5m
ER_META_REFRESH=24h
ER_MIN_VERSION_MAJOR=4
ER_MIN_SEED_MMR=3600
ER_BALANCE_BASIS=LATEST_PATCH

# Python NL2SQL agent
AGENT_DATABASE_URL=postgresql://agent_ro:change-me-agent-ro@localhost:5433/er_analytics
GEMINI_API_KEY=
GEMINI_MODEL=
