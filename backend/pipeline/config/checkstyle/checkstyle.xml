<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  들여쓰기·줄바꿈·import 순서는 Spotless(google-java-format)가 맞춘다.
  여기에는 포매터가 고칠 수 없고 사람이 판단해 고쳐야 하는 규칙만 둔다.
  예외가 필요하면 해당 위치에 @SuppressWarnings("checkstyle:규칙이름")과 이유를 적는다.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="SuppressWarningsFilter"/>
    <!-- 린터 도입 시점의 기존 위반 목록. 새 코드는 여기에 추가하지 않는다. -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- import: 어떤 클래스를 쓰는지 파일 머리에서 드러나게 한다 -->
        <module name="AvoidStarImport">
            <!-- 테스트의 Mockito·AssertJ처럼 정적 멤버를 묶어 쓰는 관용은 허용 -->
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- 수집 흐름은 DB 구현을, API 클라이언트는 수집 흐름·DB 구현을 직접 참조하지 않는다. -->
        <module name="ImportControl">
            <property name="file" value="${config_loc}/import-control.xml"/>
            <property name="path" value=".*[\\/]src[\\/]main[\\/]java[\\/].*"/>
        </module>

        <!-- 이름 규칙 -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName">
            <!-- 로거는 관례대로 소문자 log를 허용 -->
            <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>

        <!-- 타입 표기: 지역 변수·반복문·람다 인자에 var를 쓰지 않고 타입을 적는다 -->
        <module name="MatchXpath">
            <property name="id" value="NoVar"/>
            <property name="query"
                      value="//VARIABLE_DEF/TYPE/IDENT[@text='var'] | //PARAMETER_DEF/TYPE/IDENT[@text='var'] | //RESOURCE/TYPE/IDENT[@text='var']"/>
            <message key="matchxpath.match" value="var 대신 타입을 명시한다."/>
        </module>

        <!-- 실수하기 쉬운 구문 -->
        <module name="NeedBraces">
            <!-- `if (x == null) return;`처럼 한 줄에 끝나는 문장만 중괄호 생략을 허용 -->
            <property name="allowSingleLineStatement" value="true"/>
        </module>
        <module name="EmptyCatchBlock"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="ModifierOrder"/>

        <!-- 크기와 복잡도: 한 메서드가 한 번에 읽히는 범위를 넘지 않게 한다 -->
        <module name="MethodLength">
            <property name="max" value="60"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="7"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
            <property name="switchBlockAsSingleDecisionPoint" value="true"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
    </module>
</module>
